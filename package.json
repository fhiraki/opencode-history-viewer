{
  "name": "opencode-viewer",
  "version": "0.1.0",
  "description": "ローカル実行可能な OpenCode 履歴ビューワー（全文検索・タイムライン・統計）",
  "type": "module",
  "scripts": {
    "start": "node dist/server.js",
    "prestart": "npm run build",
    "dev": "node scripts/build.mjs --watch & node --watch dist/server.js",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "lint": "biome check src public test scripts",
    "format": "biome check --write src public test scripts",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^24.13.5",
    "esbuild": "^0.28.2",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.13",
    "typescript": "^7.0.2"
  }
}
